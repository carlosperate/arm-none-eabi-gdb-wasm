{
  "name": "arm-none-eabi-gdb-wasm",
  "version": "17.2.0-alpha.1",
  "description": "GNU GDB for arm-none-eabi compiled to WebAssembly. Debug bare-metal 32-bit Arm programs from a browser or Node",
  "author": "Carlos Pereira Atencio",
  "license": "SEE LICENSE IN LICENSES",
  "homepage": "https://github.com/carlosperate/arm-none-eabi-gdb-wasm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carlosperate/arm-none-eabi-gdb-wasm.git"
  },
  "bugs": {
    "url": "https://github.com/carlosperate/arm-none-eabi-gdb-wasm/issues"
  },
  "exports": {
    ".": {
      "node": {
        "types": "./lib/node.d.mts",
        "default": "./lib/node.mjs"
      },
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./dist/gdb.js": "./dist/gdb.js",
    "./dist/gdb.wasm": "./dist/gdb.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "dist/gdb.js",
    "dist/gdb.wasm",
    "dist/licenses/",
    "LICENSES",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --experimental-wasm-jspi --experimental-wasm-exnref --test test/*.test.mjs",
    "serve": "npx --yes http-server@14.1.1 -p 8000 -c-1"
  },
  "engines": {
    "node": ">=24"
  }
}
