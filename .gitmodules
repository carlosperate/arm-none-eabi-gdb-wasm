[submodule "sources/binutils-gdb"]
	path = sources/binutils-gdb
	url = https://sourceware.org/git/binutils-gdb.git
	shallow = true
[submodule "sources/gmp"]
	path = sources/gmp
	url = https://github.com/gmp-mirror/gmp-6.3.git
	shallow = true
[submodule "sources/mpfr"]
	path = sources/mpfr
	url = https://gitlab.inria.fr/mpfr/mpfr.git
	shallow = true
[submodule "sources/libexpat"]
	path = sources/libexpat
	url = https://github.com/libexpat/libexpat.git
	shallow = true
